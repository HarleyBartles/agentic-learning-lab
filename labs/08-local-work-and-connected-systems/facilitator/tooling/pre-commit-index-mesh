#!/bin/sh
set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

ROOT="labs/08-local-work-and-connected-systems/working/environment"
GENERATOR="$ROOT/tools/generate_index_mesh.py"

if [ ! -f "$GENERATOR" ]; then
  echo "index mesh generator not installed at $GENERATOR" >&2
  exit 1
fi

python "$GENERATOR" "$ROOT" | while IFS= read -r path; do
  git add -- "$path"
done
